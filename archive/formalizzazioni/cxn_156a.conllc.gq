pattern {
  A[];
  A[lemma="a"];
  A[upos=ADP];
  
  B[];
  B[upos=PRON|NOUN|PROPN];
  B[Prontype=Prs]|[!Prontype]; 
  
  C[];
  C[lemma="toccare"];
  C[upos=VERB];
  C[Number=Sing]|[!Number]; 
  C[Person=3]|[!Person]; 
  
  D[];
  D[upos=VERB];
  D[VerbForm=Inf]|[!VerbForm]; 
  
  A < B;
  B < C;
  
  B -[case]-> A;
  C -[iobj]-> B;
  C -[csubj]-> D;
  
}