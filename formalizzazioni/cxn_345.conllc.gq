pattern {
  A[];
  A[lemma="mettere"];
  A[upos=VERB];
  
  B[];
  B[upos=PRON];
  B[Clitic=Yes]|[!Clitic]; 
  B[PronType=Prs]|[!PronType]; 
  
  C[];
  C[form=/a/i];
  C[lemma="a"];
  C[upos=ADP];
  
  D[];
  D[upos=VERB];
  D[VerbForm=Inf]|[!VerbForm]; 
  
  
  A -[expl]-> B;
  D -[mark]-> C;
  A -[xcomp]-> D;
  
}