pattern {
  A [lemma="non", upos=ADV, form=/non/i, PronType=Neg];
  B [lemma="potere", upos=AUX, Mood=Ind, Number=Sing, Person=3, VerbForm=Fin];
  C [lemma="fare", upos=VERB, form=/fare/i, VerbForm=Inf];
  D [lemma="a", upos=ADP, form=/a/i];
  E [lemma="meno", upos=ADV, form=/meno/i];
  C -[advmod]-> A;
  C -[aux]-> B;
  E -[case]-> D;
  C -[advmod]-> E;
}
