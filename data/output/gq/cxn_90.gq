pattern {
  A [upos=VERB, form=/aver/i, VerbForm=Inf];
  B [lemma="ce", upos=PRON, form=/ce/i, PronType=Prs];
  C [lemma="la", upos=PRON, form=/la/i, Gender=Fem, Number=Sing, Person=3, PronType=Prs];
  D [lemma="con", upos=ADP, form=/con/i];
  E [];
  A -[expl]-> B;
  A -[obj]-> C;
  E -[case]-> D;
  A -[obl]-> E;
}
