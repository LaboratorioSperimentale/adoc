pattern {
  A [upos=ADP];
  B [Number=Sing];
  C [lemma="tutto", upos=PRON, form=/tutto/i, Gender=Masc, Number=Sing, PronType=Ind];
  D [lemma="andare", upos=VERB];
  E [lemma="a", upos=ADP, form=/a/i];
  F [Gender=Masc];
  B -[case]-> A;
  D -[obl]-> B;
  D -[nsubj]-> C;
  F -[case]-> E;
  D -[obl]-> F;
}
