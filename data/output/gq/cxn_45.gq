pattern {
  A [];
  B [lemma="contare", upos=VERB, Mood=Ind, Number=Sing, VerbForm=Fin];
  C [lemma="su", upos=ADP, form=/su/i];
  D [];
  E [lemma="per", upos=ADP, form=/per/i];
  F [lemma="il", upos=DET, form=/l'/i, Definite=Def, Number=Sing, PronType=Art];
  G [upos=NOUN, Number=Sing];
  H [lemma="di", upos=ADP, form=/di/i];
  I [lemma="il", upos=DET, Definite=Def, Number=Sing, PronType=Art];
  J [upos=NOUN, Number=Sing];
  B -[nsubj]-> A;
  D -[case]-> C;
  B -[obl]-> D;
  G -[case]-> E;
  G -[det]-> F;
  B -[obl]-> G;
  J -[case]-> H;
  J -[det]-> I;
  G -[nmod]-> J;
}
