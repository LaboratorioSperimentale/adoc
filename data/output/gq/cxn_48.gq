pattern {
  A [upos=DET];
  B [upos=NOUN];
  C [lemma="avere", upos=AUX, Mood=Ind, Person=3, VerbForm=Fin];
  D [lemma="spingere", upos=VERB, form=/spinto/i, Gender=Masc, Number=Sing, Tense=Past, VerbForm=Part];
  E [lemma="a", upos=ADP, form=/a/i];
  F [upos=VERB, VerbForm=Inf];
  B -[det]-> A;
  D -[nsubj]-> B;
  D -[aux]-> C;
  F -[mark]-> E;
  D -[xcomp]-> F;
}
