pattern {
  A [lemma="a", upos=ADP, form=/a/i];
  B [lemma="occhio", upos=NOUN, form=/occhio/i, Gender=Masc, Number=Sing];
  C [lemma="e", upos=CCONJ, form=/e/i];
  D [lemma="croce", upos=NOUN, form=/croce/i, Gender=Fem, Number=Sing];
  E [upos=VERB, Mood=Ind, Number=Sing, VerbForm=Fin];
  B -[case]-> A;
  E -[obl]-> B;
  D -[cc]-> C;
  B -[conj]-> D;
}
