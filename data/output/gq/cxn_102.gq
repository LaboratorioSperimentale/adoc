pattern {
  A [lemma="non", upos=ADV, form=/non/i, PronType=Neg];
  B [upos=PRON, Number=Sing, PronType=Prs];
  C [lemma="ne", upos=PRON, form=/ne/i, PronType=Prs];
  D [lemma="fregare", upos=VERB, form=/frega/i, Mood=Ind, Number=Sing, Person=3, Tense=Pres, VerbForm=Fin];
  E [Gender=Masc, Number=Sing];
  D -[advmod]-> A;
  D -[iobj]-> B;
  D -[obl]-> C;
  D -[obj]-> E;
}
