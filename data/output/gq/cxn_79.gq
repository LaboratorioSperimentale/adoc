pattern {
  A [lemma="menare", upos=VERB, form=/menare/i, VerbForm=Inf];
  B [lemma="il", upos=DET, form=/il/i, Definite=Def, Gender=Masc, Number=Sing, PronType=Art];
  C [lemma="cane", upos=NOUN, form=/can/i, Gender=Masc];
  D [lemma="per", upos=ADP, form=/per/i];
  E [lemma="il", upos=DET, form=/l'/i, Definite=Def, Number=Sing, PronType=Art];
  F [lemma="aia", upos=NOUN, form=/aia/i, Gender=Fem, Number=Sing];
  C -[det]-> B;
  A -[obj]-> C;
  F -[case]-> D;
  F -[det]-> E;
  A -[obl]-> F;
}
