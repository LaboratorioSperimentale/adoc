pattern {
  A [lemma="essere", upos=AUX, Mood=Ind, Number=Plur, Tense=Pres, VerbForm=Fin];
  B [upos=VERB, Gender=Masc, Number=Plur, Tense=Past, VerbForm=Part];
  C [lemma="a", upos=ADP, form=/a/i];
  D [lemma="il", upos=DET, form=/le/i, Definite=Def, Gender=Fem, Number=Plur, PronType=Art];
  E [lemma="mano", upos=NOUN, form=/mani/i, Gender=Fem, Number=Plur];
  B -[aux]-> A;
  E -[case]-> C;
  E -[det]-> D;
  B -[obl]-> E;
}
