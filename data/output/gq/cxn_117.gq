pattern {
  A [lemma="il", upos=DET, form=/il/i, Definite=Def, Gender=Masc, Number=Sing, PronType=Art];
  B [upos=NOUN, Gender=Masc];
  C [lemma="di", upos=ADP, form=/di/i];
  D [lemma="il", upos=DET, form=/i/i, Definite=Def, Gender=Masc, Number=Plur, PronType=Art];
  E [upos=NOUN, Gender=Masc, Number=Plur];
  B -[det]-> A;
  E -[case]-> C;
  E -[det]-> D;
  B -[nmod]-> E;
}
