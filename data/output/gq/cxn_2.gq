pattern {
  A [lemma="non", upos=ADV, form=/non/i, PronType=Neg];
  B [lemma="ci", upos=PRON, form=/c’/i, PronType=Prs];
  C [lemma="essere", upos=VERB, form=/è/i, Mood=Ind, Number=Sing, Person=3, Tense=Pres, VerbForm=Fin];
  D [upos=NOUN, Number=Sing];
  E [lemma="che", upos=PRON, form=/che/i];
  F [lemma="tenere", upos=VERB, form=/tenga/i, Mood=Sub, Number=Sing, Person=3, Tense=Pres, VerbForm=Fin];
  C -[advmod]-> A;
  C -[expl]-> B;
  C -[nsubj]-> D;
  F -[nsubj]-> E;
  D -[acl:relcl]-> F;
}
