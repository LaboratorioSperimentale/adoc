pattern {
  A [lemma="ancora", upos=ADV, form=/ancora/i];
  B [lemma="ora", upos=ADV, form=/ora/i];
  C [upos=VERB, Mood=Ind, Number=Sing, Person=1, Tense=Pres, VerbForm=Fin];
  D [lemma="che", upos=SCONJ, form=/che/i];
  E [];
  C -[advmod]-> A;
  C -[advmod]-> B;
  E -[mark]-> D;
  C -[ccomp]-> E;
}
