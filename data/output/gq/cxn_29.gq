pattern {
  A [lemma="essere", upos=AUX, form=/è/i, Mood=Ind, Number=Sing, Person=3, Tense=Pres, VerbForm=Fin];
  B [lemma="il", upos=DET, form=/l'/i, Definite=Def, Number=Sing, PronType=Art];
  C [lemma="ennesimo", upos=ADJ, NumType=Ord, Number=Sing];
  D [upos=NOUN, Number=Sing];
  E [];
  F [upos=VERB];
  D -[cop]-> A;
  D -[det]-> B;
  D -[amod]-> C;
  F -[obj]-> E;
  D -[acl:relcl]-> F;
}
