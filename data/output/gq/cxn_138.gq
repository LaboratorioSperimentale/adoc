pattern {
  A [lemma="fare", upos=VERB];
  B [lemma="il", upos=DET, form=/la/i, Definite=Def, Gender=Fem, Number=Sing, PronType=Art];
  C [lemma="figura", upos=NOUN, form=/figura/i, Gender=Fem, Number=Sing];
  D [lemma="di", upos=ADP, form=/di/i];
  E [lemma="il", upos=DET, form=/il/i, Definite=Def, Gender=Masc, Number=Sing, PronType=Art];
  F [Gender=Masc, Number=Sing];
  C -[det]-> B;
  A -[obj]-> C;
  F -[case]-> D;
  F -[det]-> E;
  C -[nmod]-> F;
}
