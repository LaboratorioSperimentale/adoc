pattern {
  A [lemma="di", upos=ADP, form=/di/i];
  B [lemma="avere", upos=VERB, form=/avere/i, VerbForm=Inf];
  C [upos=DET, Definite=Def, Number=Sing, PronType=Art];
  D [upos=NOUN, Number=Sing];
  E [lemma="in", upos=ADP, form=/in/i];
  F [lemma="tasca", upos=NOUN, form=/tasca/i, Gender=Fem, Number=Sing];
  B -[mark]-> A;
  D -[det]-> C;
  B -[obj]-> D;
  F -[case]-> E;
  D -[nmod]-> F;
}
