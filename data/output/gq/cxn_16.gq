pattern {
  A [upos=VERB];
  B [lemma="in", upos=ADP, form=/in/i];
  C [lemma="meno", upos=ADV, form=/men/i];
  D [lemma="che", upos=SCONJ, form=/che/i];
  E [lemma="non", upos=ADV, form=/non/i, PronType=Neg];
  F [lemma="si", upos=PRON, form=/si/i, Person=3, PronType=Prs];
  G [lemma="dire", upos=VERB, form=/dica/i, Mood=Sub, Number=Sing, Person=3, Tense=Pres, VerbForm=Fin];
  C -[case]-> B;
  A -[advmod]-> C;
  G -[mark]-> D;
  G -[advmod]-> E;
  G -[expl:impers]-> F;
  C -[advcl]-> G;
}
