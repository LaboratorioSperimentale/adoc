pattern {
  A [lemma="mandare", upos=VERB];
  B [lemma="a", upos=ADP, form=/a/i];
  C [lemma="il", upos=DET, form=/l'/i, Definite=Def, Number=Sing, PronType=Art];
  D [lemma="aria", upos=NOUN, form=/aria/i, Gender=Fem, Number=Sing];
  E [upos=DET, Gender=Fem, PronType=Art];
  F [upos=NOUN, Gender=Fem];
  D -[case]-> B;
  D -[det]-> C;
  A -[obl]-> D;
  F -[det]-> E;
  A -[obj]-> F;
}
